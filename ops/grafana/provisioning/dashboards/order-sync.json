{
  "uid": "order-sync",
  "title": "Order Sync",
  "description": "Salesforce to ERP integration health. Outbox Age is the panel worth alerting on.",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Outbox Age",
      "description": "Age of the oldest undrained row. Rising means the relay has stopped making progress and orders are not reaching the ERP. This is the alert.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          },
          "noValue": "0"
        }
      },
      "targets": [
        {
          "expr": "ordersync_outbox_oldest_age_seconds",
          "legendFormat": "oldest row",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Outbox Depth",
      "description": "Rows waiting. Spikes are normal under load; a plateau is not.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "ordersync_outbox_depth",
          "legendFormat": "queued",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Dead Letters (1h)",
      "description": "Messages parked because they could not be delivered. Any non-zero value needs a human.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "(sum(increase(ordersync_consumer_dead_lettered_total[1h])) or vector(0)) + (sum(increase(ordersync_outbox_dead_lettered_total[1h])) or vector(0))",
          "legendFormat": "dead lettered",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Orders Delivered (5m)",
      "description": "Orders successfully pushed into the ERP.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(ordersync_erp_forwarded_total[5m])) or vector(0)",
          "legendFormat": "orders",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Throughput",
      "description": "Events in from Salesforce against orders out to the ERP. A persistent gap means work is accumulating somewhere in between.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8
          }
        }
      },
      "targets": [
        {
          "expr": "rate(ordersync_salesforce_events_received_total[5m])",
          "legendFormat": "received from Salesforce",
          "refId": "A"
        },
        {
          "expr": "rate(ordersync_outbox_published_total[5m])",
          "legendFormat": "published to Kafka",
          "refId": "B"
        },
        {
          "expr": "rate(ordersync_erp_forwarded_total[5m])",
          "legendFormat": "forwarded to ERP",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "ERP Latency",
      "description": "Time to push one order into the ERP.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ordersync_erp_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(ordersync_erp_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Failures",
      "description": "Publish failures, undecodable events, and Salesforce write rejections.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8
          }
        }
      },
      "targets": [
        {
          "expr": "rate(ordersync_outbox_failed_total[5m])",
          "legendFormat": "outbox publish failures",
          "refId": "A"
        },
        {
          "expr": "rate(ordersync_salesforce_decode_failures_total[5m])",
          "legendFormat": "undecodable events",
          "refId": "B"
        },
        {
          "expr": "rate(ordersync_salesforce_fulfillment_rejected_total[5m])",
          "legendFormat": "Salesforce upsert rejections",
          "refId": "C"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Kafka Consumer Lag",
      "description": "Records behind the head of each partition.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8
          }
        }
      },
      "targets": [
        {
          "expr": "sum(kafka_consumer_fetch_manager_records_lag) by (client_id)",
          "legendFormat": "{{client_id}}",
          "refId": "A"
        }
      ]
    }
  ]
}
