<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <!-- Without a masterLabel the component appears in the Lightning App Builder
         palette under its raw API name, which an admin has no reason to recognise. -->
    <masterLabel>Integration Status</masterLabel>
    <description>Shows whether this order reached the ERP, its fulfillment status, and a button to resend it.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Order</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
